# ============================================================================
# EduNestIO — example environment variables (PLACEHOLDERS ONLY, no secrets)
# ============================================================================
# The API reads config from backend/.../config/appsettings.json plus environment
# variables. Env vars use "__" (double underscore) as the section separator.
# Copy values into your shell / a local uncommitted file; never commit real secrets.
# ============================================================================

# ---- Database (PostgreSQL) -------------------------------------------------
# Used by the API and by the database apply scripts.
EDUNESTIO_DB_CONNECTION=Host=localhost;Port=5432;Database=edunestio;Username=postgres;Password=CHANGE_ME
# Equivalent configuration-style variable the API also understands:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=edunestio;Username=postgres;Password=CHANGE_ME

# ---- Development demo seeding (Development only) ----------------------------
# When Seed__Enabled=true and ASPNETCORE_ENVIRONMENT=Development, the API creates
# demo users with securely hashed passwords on startup. The password is supplied
# here, never hard-coded in source or SQL.
Seed__Enabled=true
Seed__DemoUserPassword=CHANGE_ME_demo_password_Str0ng!

# ---- Integration tests -----------------------------------------------------
# Point the DB-backed xUnit tests at a test database that already has the
# /database scripts applied. If unset, DB-backed tests no-op (pass).
EDUNESTIO_TEST_DB=Host=localhost;Port=5432;Database=edunestio_test;Username=postgres;Password=CHANGE_ME

# ---- CORS ------------------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:4200

# ---- Hosting ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
